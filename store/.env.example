# ─── Quelra store — environment variables ───────────────────────────────
# Copy to `.env.local` and fill in. NEVER commit real values.

# ── Stripe (server-side; hosted Checkout) ──
# Use test keys (sk_test_… / pk_test_…) until go-live.
STRIPE_SECRET_KEY=sk_test_xxx
# One Stripe Price per offer-ladder tier (create in Stripe Dashboard → Products).
STRIPE_PRICE_CORE=price_xxx          # Core: device + 14-day protocol — $44.99
STRIPE_PRICE_BUMP=price_xxx          # Day kit: laptop stand add-on — sold as separate line item
STRIPE_PRICE_FAMILY=price_xxx        # Family ×2 — $79

# ── Public site URL (used for Checkout success/cancel redirects) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Tracking (public pixel IDs — safe to expose client-side) ──
# One pixel per platform for the WHOLE umbrella domain (shared across backup lines).
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
